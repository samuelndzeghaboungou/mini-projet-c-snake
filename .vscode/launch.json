{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Snake: Run Script (PowerShell)",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/run.ps1",
            "args": []
        },
        {
            "name": "Snake: Build and Launch",
            "type": "cppvsdbg",
